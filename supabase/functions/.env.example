# supabase/functions/.env.example
# Copy to supabase/functions/.env.local for `supabase functions serve`.
# VAPID_KEYS_JSON: output of scripts/generate-vapid-keys.mjs (single line).
VAPID_KEYS_JSON={"publicKey":{},"privateKey":{}}
VAPID_CONTACT_EMAIL=you@example.com
PUSH_FUNCTION_SECRET=local-dev-push-secret
APP_URL=http://localhost:3000
